# Copiar a .env (raíz) en el VPS y completar.
# Estas variables las usa docker-compose.prod.yml para el servicio mysql-db.
# IMPORTANTE: MYSQL_ROOT_PASSWORD tiene que ser IGUAL al valor de
# SPRING_DATASOURCE_PASSWORD en validador-backend/.env.

MYSQL_ROOT_PASSWORD=cambiar_por_password_segura
MYSQL_DATABASE=mercado_pago_validador_db
